# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset for local development: a SQLite file is created at data/app.db.
#
# Production (Vercel): use Neon Postgres. Paste the *pooled* connection string
# from the Neon dashboard (or connect Neon from Vercel → Storage, which sets
# DATABASE_URL for you). Tables and seed data are created automatically.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# Any other Postgres works too (uses the `pg` driver), as does libSQL/Turso:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
#
# Force a driver for Postgres URLs: "neon" (HTTP) or "pg" (TCP). Auto-detected
# from the host name (*.neon.tech → neon) when unset.
# DATABASE_DRIVER=neon

# Hold community submissions for review instead of publishing immediately.
# SUBMISSIONS_REQUIRE_REVIEW=true

# Screenshot service used for portfolios without a bundled preview.
# "{url}" is replaced with the portfolio URL, "{encodedUrl}" with it URI-encoded.
# NEXT_PUBLIC_SCREENSHOT_URL=https://image.thum.io/get/width/640/crop/800/noanimate/{url}
